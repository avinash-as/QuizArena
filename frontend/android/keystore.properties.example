# Copy this file to keystore.properties (same folder) and fill in your real values.
# keystore.properties is gitignored — never commit your real keystore password.
#
# Generate the keystore first, from frontend/android/, with:
#   keytool -genkey -v -keystore quizarena.keystore -alias quizarena -keyalg RSA -keysize 2048 -validity 10000
#
# Then fill in the same path/alias/passwords you used below.

storeFile=quizarena.keystore
storePassword=CHANGE_ME
keyAlias=quizarena
keyPassword=CHANGE_ME
